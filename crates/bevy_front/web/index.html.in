<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#16181d">
  <title>Temporal Chess</title>
  <script>
    function resolveLanguage(saved, preferred) {
      if (saved === 'ru' || saved === 'en') return saved;
      for (const tag of preferred) {
        const base = String(tag).toLowerCase().split(/[-_]/)[0];
        if (base === 'ru' || base === 'en') return base;
      }
      return 'en';
    }
    let savedLanguage = null;
    try { savedLanguage = localStorage.getItem('temporal-chess.language'); } catch (_) {}
    document.documentElement.lang = resolveLanguage(savedLanguage, navigator.languages?.length ? navigator.languages : [navigator.language]);
    function pageText(ru, en) { return document.documentElement.lang === 'ru' ? ru : en; }
  </script>
  <link rel="icon" type="image/svg+xml" sizes="any" href="./releases/__NOLAN_RELEASE__/favicon.svg">
  <style>
    html, body { width:100%; height:100%; margin:0; overflow:hidden; background:#16181d; color:#e7eaf1; font:16px system-ui,sans-serif; }
    canvas { display:block; width:100%; height:100%; outline:none; touch-action:none; }
    #loading { position:fixed; inset:0; display:grid; place-content:center; text-align:center; gap:12px; background:#16181d; z-index:2; padding:24px; }
    #loading small { color:#9ba3b4; max-width:480px; }
    #loading[hidden] { display:none; }
  </style>
</head>
<body>
  <canvas id="game" tabindex="0" aria-label="Temporal Chess"></canvas>
  <div id="loading"><strong>Temporal Chess</strong><small id="status">Loading game…</small></div>
  <noscript>JavaScript and WebGL2 are required. Для игры необходимы JavaScript и WebGL2.</noscript>
  <script>document.getElementById('status').textContent = pageText('Загрузка игры…', 'Loading game…');</script>
  <script type="module">
    const canvas = document.getElementById('game');
    const loading = document.getElementById('loading');
    const status = document.getElementById('status');
    canvas.addEventListener('contextmenu', event => event.preventDefault());
    canvas.addEventListener('keydown', event => {
      const clipboard = !event.altKey && (
        ((event.ctrlKey || event.metaKey) && ['KeyC', 'KeyX', 'KeyV'].includes(event.code)) ||
        (event.shiftKey && ['Insert', 'Delete'].includes(event.code)) ||
        (event.ctrlKey && event.code === 'Insert')
      );
      if (!clipboard) event.preventDefault();
    });
    canvas.addEventListener('wheel', event => event.preventDefault(), { passive: false });
    canvas.addEventListener('webglcontextlost', () => {
      loading.hidden = false;
      status.textContent = pageText('Графический контекст потерян. Перезагрузите страницу; к сетевой партии можно подключиться снова по коду.', 'Graphics context lost. Reload the page; you can rejoin an online game using its code.');
    });
    try {
      if (!document.createElement('canvas').getContext('webgl2')) throw new Error(pageText('Браузер не поддерживает WebGL2.', 'Your browser does not support WebGL2.'));
      const { default: init } = await import('./releases/__NOLAN_RELEASE__/nolan.js');
      await init();
    } catch (error) {
      // winit transfers control to the browser event loop using this exception.
      if (!String(error).includes("Using exceptions for control flow")) {
        console.error(error);
        loading.hidden = false;
        status.textContent = pageText('Не удалось запустить игру: ', 'Could not start the game: ') + (error.message || error);
      }
    }
  </script>
</body>
</html>
