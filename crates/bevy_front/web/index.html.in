<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#16181d">
  <title>Temporal Chess</title>
  <script>
    function resolveLanguage(saved, preferred) {
      if (saved === 'ru' || saved === 'en') return saved;
      for (const tag of preferred) {
        const base = String(tag).toLowerCase().split(/[-_]/)[0];
        if (base === 'ru' || base === 'en') return base;
      }
      return 'en';
    }
    let savedLanguage = null;
    try { savedLanguage = localStorage.getItem('temporal-chess.language'); } catch (_) {}
    document.documentElement.lang = resolveLanguage(savedLanguage, navigator.languages?.length ? navigator.languages : [navigator.language]);
    function pageText(ru, en) { return document.documentElement.lang === 'ru' ? ru : en; }
    document.documentElement.dataset.touchDevice = String(navigator.maxTouchPoints > 0 && matchMedia('(pointer: coarse)').matches);
  </script>
  <link rel="icon" type="image/svg+xml" sizes="any" href="./releases/__NOLAN_RELEASE__/favicon.svg">
  <style>
    html, body { width:100%; height:100%; margin:0; overflow:hidden; background:#16181d; color:#e7eaf1; font:16px system-ui,sans-serif; }
    canvas { display:block; width:100%; height:100%; outline:none; touch-action:none; }
    body { overscroll-behavior:none; height:100dvh; }
    #loading { position:fixed; inset:0; display:grid; place-content:center; text-align:center; gap:12px; background:#16181d; z-index:2; padding:24px; }
    #loading small { color:#9ba3b4; max-width:480px; }
    #loading[hidden] { display:none; }
    #mobile-import {
      box-sizing:border-box;
      position:fixed;
      inset:calc(var(--import-viewport-top, 0px) + max(12px, env(safe-area-inset-top))) 0 auto;
      margin:0 auto;
      width:min(560px, calc(100% - 24px));
      max-height:calc(var(--import-viewport-height, 100dvh) - max(12px, env(safe-area-inset-top)) - 12px);
      overflow:auto;
      padding:16px;
      color:inherit;
      background:#1e2128;
      border:1px solid #373c47;
      border-radius:14px;
    }
    #mobile-import::backdrop { background:rgba(0,0,0,0.55); }
    #mobile-import h2 { margin:0 0 8px; font-size:19px; }
    #mobile-import label { display:block; margin-bottom:10px; color:#a3abbc; }
    #mobile-import fieldset { min-width:0; margin:0; padding:0; border:0; }
    #import-record {
      box-sizing:border-box;
      display:block;
      width:100%;
      height:clamp(80px, 35dvh, 300px);
      padding:10px;
      color:inherit;
      background:#16181d;
      border:1px solid #373c47;
      border-radius:8px;
      font:16px monospace;
      resize:vertical;
      touch-action:auto;
      user-select:text;
      -webkit-user-select:text;
    }
    #import-record:focus-visible { outline:2px solid #9cb2ef; outline-offset:1px; }
    .import-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }
    #mobile-import button {
      min-height:44px;
      padding:0 12px;
      color:inherit;
      background:#282c35;
      border:1px solid #373c47;
      border-radius:8px;
      font:inherit;
    }
    #mobile-import button[type="submit"] { background:#3f4c6e; }
    #import-status { margin:0; overflow-wrap:anywhere; }
    #import-status:not(:empty) { margin-top:10px; }
    #import-status[data-error="true"] { color:#ff8993; }
    html:lang(ru) #mobile-import [lang="en"],
    html:lang(en) #mobile-import [lang="ru"] { display:none; }
  </style>
</head>
<body>
  <canvas id="game" tabindex="0" aria-label="Temporal Chess"></canvas>
  <dialog id="mobile-import" aria-labelledby="import-title">
    <h2 id="import-title" tabindex="-1" autofocus><span lang="ru">Загрузить партию</span><span lang="en">Import game</span></h2>
    <form id="import-form">
      <fieldset id="import-fields">
        <label for="import-record"><span lang="ru">Введите запись партии или вставьте её из буфера обмена.</span><span lang="en">Type or paste a game record.</span></label>
        <textarea id="import-record" spellcheck="false" autocapitalize="off" autocorrect="off" required></textarea>
        <div class="import-actions">
          <button type="submit"><span lang="ru">Загрузить</span><span lang="en">Import</span></button>
          <button type="button" id="import-cancel"><span lang="ru">Отмена</span><span lang="en">Cancel</span></button>
        </div>
      </fieldset>
    </form>
    <p id="import-status" role="status"></p>
  </dialog>
  <div id="loading"><strong>Temporal Chess</strong><small id="status">Loading game…</small></div>
  <noscript>JavaScript and WebGL2 are required. Для игры необходимы JavaScript и WebGL2.</noscript>
  <script>document.getElementById('status').textContent = pageText('Загрузка игры…', 'Loading game…');</script>
  <script type="module">
    const canvas = document.getElementById('game');
    const loading = document.getElementById('loading');
    const status = document.getElementById('status');
    const importDialog = document.getElementById('mobile-import');
    const importFields = document.getElementById('import-fields');
    const importRecord = document.getElementById('import-record');
    function chooseImportAction(action) {
      if (importFields.disabled) return;
      importDialog.dataset.action = action;
      importDialog.dispatchEvent(new Event('nolan-import-action'));
    }
    document.getElementById('import-form').addEventListener('submit', event => {
      event.preventDefault();
      if (importRecord.value.trim()) chooseImportAction('submit');
    });
    document.getElementById('import-cancel').addEventListener('click', () => chooseImportAction('cancel'));
    importDialog.addEventListener('cancel', event => {
      event.preventDefault();
      chooseImportAction('cancel');
    });
    // Leave native editing and clipboard defaults in place. The canvas input
    // integration must not receive these events or steal focus from the field.
    for (const name of ['keydown', 'keyup', 'copy', 'cut', 'paste', 'touchstart', 'touchend']) {
      importDialog.addEventListener(name, event => event.stopPropagation());
    }
    if (window.visualViewport) {
      const visual = window.visualViewport;
      const fitImportDialog = () => {
        importDialog.style.setProperty('--import-viewport-height', `${visual.height}px`);
        importDialog.style.setProperty('--import-viewport-top', `${visual.offsetTop}px`);
      };
      visual.addEventListener('resize', fitImportDialog);
      visual.addEventListener('scroll', fitImportDialog);
      fitImportDialog();
    }
    canvas.addEventListener('contextmenu', event => event.preventDefault());
    canvas.addEventListener('keydown', event => {
      const clipboard = !event.altKey && (
        ((event.ctrlKey || event.metaKey) && ['KeyC', 'KeyX', 'KeyV'].includes(event.code)) ||
        (event.shiftKey && ['Insert', 'Delete'].includes(event.code)) ||
        (event.ctrlKey && event.code === 'Insert')
      );
      if (!clipboard) event.preventDefault();
    });
    canvas.addEventListener('wheel', event => event.preventDefault(), { passive: false });
    canvas.addEventListener('webglcontextlost', () => {
      loading.hidden = false;
      status.textContent = pageText('Графический контекст потерян. Перезагрузите страницу; к сетевой партии можно подключиться снова по коду.', 'Graphics context lost. Reload the page; you can rejoin an online game using its code.');
    });
    try {
      if (!document.createElement('canvas').getContext('webgl2')) throw new Error(pageText('Браузер не поддерживает WebGL2.', 'Your browser does not support WebGL2.'));
      const sound = await import('./releases/__NOLAN_RELEASE__/sound.js');
      Object.assign(globalThis, { nolanMoveSound: sound.movement, nolanMusic: sound.setMusic });
      const bot = await import('./releases/__NOLAN_RELEASE__/tempfish-pool.js');
      Object.assign(globalThis, { tempfishStart: bot.start, tempfishPoll: bot.poll, tempfishStop: bot.stop, tempfishCancel: bot.cancel });
      const { default: init } = await import('./releases/__NOLAN_RELEASE__/nolan.js');
      await init();
    } catch (error) {
      // winit transfers control to the browser event loop using this exception.
      if (!String(error).includes("Using exceptions for control flow")) {
        console.error(error);
        loading.hidden = false;
        status.textContent = pageText('Не удалось запустить игру: ', 'Could not start the game: ') + (error.message || error);
      }
    }
  </script>
</body>
</html>
